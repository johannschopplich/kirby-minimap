{
  "name": "kirby-minimap",
  "type": "module",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "kirbyup serve src/panel/index.js",
    "build": "kirbyup src/panel/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@unocss/eslint-plugin": "^66.10.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "kirby-types": "^1.6.1",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.3.1",
    "prettier": "^3.9.6",
    "unocss": "^66.10.0",
    "zx": "^8.8.5"
  }
}
