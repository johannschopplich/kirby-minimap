{
  "name": "kirby-minimap",
  "type": "module",
  "version": "2.0.1",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "kirbyup dev src/panel/index.ts",
    "build": "kirbyup src/panel/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" \"tests/panel/**\" --write",
    "test": "vitest",
    "test:types": "vue-tsc --noEmit",
    "release": "pnpm run build && bumpp --all --execute \"node scripts/pre-release.mjs\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.11",
    "@unocss/eslint-plugin": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "kirby-types": "^2.0.0",
    "kirbyup": "^4.0.0",
    "kirbyuse": "^2.0.0",
    "prettier": "^3.10.1",
    "tinyexec": "^1.4.0",
    "typescript": "^6.0.3",
    "unocss": "^66.13.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
