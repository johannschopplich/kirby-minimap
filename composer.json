{
  "name": "johannschopplich/kirby-minimap",
  "description": "Jump to any field or block from a sidebar",
  "type": "kirby-plugin",
  "version": "1.4.1",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "navigation",
    "sidebar"
  ],
  "license": "MIT",
  "homepage": "https://kirby.tools/minimap",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "getkirby/composer-installer": "^1"
  },
  "require-dev": {
    "getkirby/cms": "^6.0@beta",
    "vlucas/phpdotenv": "^5"
  },
  "conflict": {
    "getkirby/cms": "<6"
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t playground/public vendor/getkirby/cms/router.php"
    ],
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "dist": "composer install --no-dev"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
